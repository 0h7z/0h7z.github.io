{
	"name": "0h7z",
	"type": "module",
	"version": "0.0.0",
	"license": "AGPL-3.0-only",
	"private": true,
	"scripts": {
		"rst": "pnpm up -f && pnpm postupd -v",
		"upd": "pnpm up --latest && pnpm dedupe && pnpm up -s",
		"dev": "vitepress dev",
		"test": "tsc && vue-tsc",
		"build": "vitepress build",
		"serve": "vite preview",
		"preview": "pnpm build && pnpm serve",
		"postupd": "julia --project icon.jl && julia --project node.jl",
		"prebuild": "julia --project docs.jl && tsc",
		"postbuild": "julia --project docs.jl build"
	},
	"devDependencies": {
		"@pnpm/types": "latest-10",
		"@primer/octicons": "^19.42.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"prettier": "^3.10.1",
		"vitepress": "next",
		"vue-tsc": "^3.3.14"
	},
	"optionalDependencies": {
		"@types/markdown-it": "^14.2.0",
		"@types/node": "^26.6.6",
		"@vitejs/plugin-vue": "^6.0.11",
		"@vue/compiler-core": "^3.5.46",
		"@vue/compiler-sfc": "^3.5.46",
		"@vue/reactivity": "^3.5.46",
		"@vue/runtime-core": "^3.5.46",
		"@vue/runtime-dom": "^3.5.46",
		"csstype": "^3.2.4",
		"esbuild": "^0.28.2",
		"less": "^4.9.1",
		"markdown-it-mathjax3": "https://codeload.github.com/Heptazhou/markdown-it-mathjax3/tar.gz/v4.4.4",
		"rolldown": "^1.2.19",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vue": "^3.5.46"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0 <11"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"@docsearch/css": "-",
			"@docsearch/js": "-",
			"@docsearch/sidepanel-js": "-",
			"@iconify-json/simple-icons": "-",
			"@volar/language-service": "-",
			"@volar/typescript>vscode-uri": "-",
			"@vue/devtools-api": "-",
			"commander": "-",
			"encoding-sniffer": ">=1",
			"entities": ">=7 <8",
			"glob": ">=13",
			"htmlparser2": ">=10 <11",
			"mime": ">=2 <4",
			"needle": ">=3",
			"rolldown": ">=1.2 <1.3"
		},
		"packageExtensions": {
			"@mathjax/mathjax-newcm-font": {
				"dependencies": {
					"@mathjax/src": "*"
				}
			},
			"vitepress": {
				"dependencies": {
					"@primer/octicons": "*"
				}
			},
			"vue-tsc": {
				"optionalDependencies": {
					"typescript": "npm:typescript-native-bridge"
				}
			}
		},
		"updateConfig": {
			"ignoreDependencies": [
				"markdown-it-mathjax3"
			]
		}
	}
}
