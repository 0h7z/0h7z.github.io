{
	"name": "0h7z",
	"type": "module",
	"version": "0.0.0",
	"license": "AGPL-3.0-only",
	"private": true,
	"scripts": {
		"rst": "pnpm up -f && pnpm postupd -v",
		"upd": "pnpm up --latest && pnpm dedupe && pnpm up -s",
		"dev": "vitepress dev",
		"test": "tsc",
		"build": "vitepress build",
		"serve": "vite preview",
		"preview": "pnpm build && pnpm serve",
		"postupd": "julia --project icon.jl && julia --project node.jl",
		"prebuild": "julia --project docs.jl && tsc",
		"postbuild": "julia --project docs.jl build"
	},
	"devDependencies": {
		"@pnpm/types": "latest-10",
		"@primer/octicons": "^19.32.0",
		"@types/markdown-it-footnote": "^3.0.4",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"markdown-it-footnote": "^4.0.0",
		"prettier": "^3.9.6",
		"vitepress": "next"
	},
	"optionalDependencies": {
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^26.1.2",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/compiler-core": "^3.5.40",
		"@vue/compiler-sfc": "^3.5.40",
		"@vue/reactivity": "^3.5.40",
		"@vue/runtime-core": "^3.5.40",
		"@vue/runtime-dom": "^3.5.40",
		"csstype": "^3.2.3",
		"esbuild": "^0.28.1",
		"less": "^4.8.1",
		"markdown-it-mathjax3": "https://codeload.github.com/Heptazhou/markdown-it-mathjax3/tar.gz/v4.4.3",
		"rolldown": "^1.2.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vue": "^3.5.40"
	},
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0 <11"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"@docsearch/css": "-",
			"@docsearch/js": "-",
			"@docsearch/sidepanel-js": "-",
			"@iconify-json/simple-icons": "-",
			"@vue/devtools-api": "-",
			"encoding-sniffer": ">=1",
			"htmlparser2": ">=10 <11",
			"needle": ">=3",
			"rolldown": ">=1"
		},
		"packageExtensions": {
			"@mathjax/mathjax-newcm-font": {
				"peerDependencies": {
					"@mathjax/src": "*"
				}
			}
		},
		"updateConfig": {
			"ignoreDependencies": [
				"markdown-it-mathjax3"
			]
		}
	}
}
